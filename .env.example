# Plantilla de variables de entorno.
#
# Copiala a `.env` (que está ignorado por git) y completá los valores.
#
# Este archivo SE VERSIONA a propósito, así que documenta la FORMA de cada
# variable y nunca un valor real: ni el de producción, ni el de la base local.
# Los valores de la base local salen de `docker-compose.yml`; los de producción,
# del panel de Neon.

# Cadena de conexión que usa la aplicación en tiempo de ejecución.
# En Neon es la cadena con pooler.
DATABASE_URL="postgresql://usuario:clave@host:puerto/base"

# Cadena de conexión sin pooler, para drizzle-kit.
# En local vale exactamente lo mismo que DATABASE_URL.
#
# Solo la lee drizzle-kit, que corre desde la máquina de quien migra y nunca en
# Vercel. El nombre coincide a propósito con el que ya inyecta sola la
# integración de Neon en Vercel, administrada por la integración y de solo
# lectura: no hace falta cargarla a mano ahí ni mantenerla en el panel, que
# sería un duplicado que queda desactualizado en cuanto se rote la contraseña.
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host:puerto/base"

# Confirmación para escribir en una base que no es la local (importar contenido
# y migrar). Vale exactamente el host del destino. NO va en el .env: se antepone
# al comando de esa corrida, por ejemplo:
#   DB_CONFIRMAR_DESTINO=<host> pnpm db:migrate
# DB_CONFIRMAR_DESTINO=host-del-destino

# Configuración de Better Auth (ADR 0019), el módulo `identidad`.
#
# Las cuatro variables se leen en el primer uso de Better Auth, no al compilar:
# `next build` no falla si faltan, pero la primera petición que las necesite
# (la ruta /api/auth, iniciar sesión, registrarse) lanza un error que nombra la
# que falta. Aun así hay que cargarlas en TODOS los entornos de Vercel donde se
# use la aplicación:
#
#   Variable               Production  Preview  Development
#   BETTER_AUTH_SECRET     si          si       si (o `.env` local)
#   BETTER_AUTH_URL        si          si       si (o `.env` local)
#   GOOGLE_CLIENT_ID       si          si       si (o `.env` local)
#   GOOGLE_CLIENT_SECRET   si          si       si (o `.env` local)
#
# El secreto y la URL son DISTINTOS por entorno; las credenciales de Google
# pueden compartirse entre entornos o usar un cliente OAuth por entorno.

# Clave de al menos 32 caracteres, de alta entropía, que Better Auth usa para
# firmar y cifrar (cookies de sesión, tokens). Generala una vez por entorno,
# nunca la reutilices entre local y producción.
# `openssl rand -base64 32` genera un valor válido.
BETTER_AUTH_SECRET="clave-de-al-menos-32-caracteres-alta-entropia"

# URL base de la aplicación, sin barra final. CAMBIA POR ENTORNO: en local, la
# del servidor de desarrollo; en Production, el dominio público; en Preview,
# la URL del despliegue de preview (que en Vercel cambia en cada despliegue, así
# que hay que fijar una estable para Preview o aceptar que Google no la reconozca).
BETTER_AUTH_URL="http://localhost:3000"

# Credenciales OAuth de un cliente "Web application" creado en Google Cloud
# Console. El URI de redirección autorizado se registra POR CADA URL desde la
# que se inicie sesión, con la forma `<BETTER_AUTH_URL>/api/auth/callback/google`:
#   http://localhost:3000/api/auth/callback/google
#   https://<dominio-de-production>/api/auth/callback/google
#   https://<url-de-preview>/api/auth/callback/google
# Google rechaza el inicio de sesión (redirect_uri_mismatch) si el URI del
# entorno no está registrado.
GOOGLE_CLIENT_ID="id-de-cliente-oauth-de-google"
GOOGLE_CLIENT_SECRET="secreto-de-cliente-oauth-de-google"
