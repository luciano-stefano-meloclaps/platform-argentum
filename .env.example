# Plantilla de variables de entorno.
#
# Copiala a `.env` (que está ignorado por git) y completá los valores.
#
# Este archivo SE VERSIONA a propósito, así que documenta la FORMA de cada
# variable y nunca un valor real: ni el de producción, ni el de la base local.
# Los valores de la base local salen de `docker-compose.yml`; los de producción,
# del panel de Neon.

# Cadena de conexión que usa la aplicación en tiempo de ejecución.
# En Neon es la cadena con pooler.
DATABASE_URL="postgresql://usuario:clave@host:puerto/base"

# Cadena de conexión sin pooler, para drizzle-kit.
# En local vale exactamente lo mismo que DATABASE_URL.
#
# Solo la lee drizzle-kit, que corre desde la máquina de quien migra y nunca en
# Vercel. Por eso esta variable NO se carga en Vercel: allá la integración de
# Neon ya inyecta la cadena sin pooler con su propio nombre,
# DATABASE_URL_UNPOOLED, administrada por la integración y de solo lectura.
# No la copies a mano al panel de Vercel: sería un duplicado que nadie lee y que
# queda desactualizado en cuanto se rote la contraseña.
DATABASE_URL_DIRECT="postgresql://usuario:clave@host:puerto/base"
